<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="shortcut icon" type="image/png" href="/img/favicon.png" />
    <link
      href="https://fonts.googleapis.com/css?family=Lato:300,300i,700"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  </head>
  <body>
    <%- include('header') %>
    <main class="main">
      <div class="user-view">
        <nav class="user-view__menu">
          <ul class="side-nav">
            <%- include('partials/navItem', {link: '#', icon: 'settings', title:
            'Settings', active: true}) %>
            <!-- prettier-ignore -->
            <%- include('partials/navItem', {link:
            '#', icon: 'briefcase', title: 'My bookings', active: false}) %>
            <!-- prettier-ignore -->
            <%- include('partials/navItem', {link:
            '#', icon: 'star', title: 'My reviews', active: false}) %>
            <!-- prettier-ignore -->
            <%- include('partials/navItem', {link:
            '#', icon: 'credit-card', title: 'Billing', active: false}) %>
          </ul>
          <% if (user?.role === 'admin') { %>
          <div class="admin-nav">
            <h5 class="admin-nav__heading">Admin</h5>
            <ul class="side-nav">
              <!-- prettier-ignore -->
              <%- include('partials/navItem', {link:
              '#', icon: 'map', title: 'Manage tours', active: false}) %>
              <!-- prettier-ignore -->
              <%- include('partials/navItem', {link:
              '#', icon: 'location-pin', title: 'Manage locations', active: false}) %>
              <!-- prettier-ignore -->
              <%- include('partials/navItem', {link:
              '#', icon: 'users', title: 'Manage users', active: false}) %>
              <!-- prettier-ignore -->
              <%- include('partials/navItem', {link:
              '#', icon: 'star', title: 'Manage reviews', active: false}) %>
              <!-- prettier-ignore -->
              <%- include('partials/navItem', {link:
              '#', icon: 'credit-card', title: 'Manage bookings', active: false}) %>
            </ul>
          </div>
          <% } %>
        </nav>
        <div class="user-view__content">
          <div class="user-view__form-container">
            <h2 class="heading-secondary ma-bt-md">Your account settings</h2>
            <form class="form form-user-data" action="/submit-user-data" method="POST">
              <div class="form__group">
                <label class="form__label" for="name">Name</label>
                <input
                  id="name"
                  name="name"
                  class="form__input"
                  type="text"
                  value="<%= user.name %>"
                  required
                />
              </div>
              <div class="form__group ma-bt-md">
                <label class="form__label" for="email">Email address</label>
                <input
                  id="email"
                  name="email"
                  class="form__input"
                  type="email"
                  value="<%= user.email %>"
                  required
                />
              </div>
              <div class="form__group form__photo-upload">
                <img
                  class="form__user-photo"
                  src="/img/users/<%= user.photo %>"
                  alt="User photo"
                />
                <a class="btn-text" href="#">Choose new photo</a>
              </div>
              <div class="form__group right">
                <button class="btn btn--small btn--green" type="submit">
                  Save settings
                </button>
              </div>
            </form>
          </div>
  
          <div class="line">&nbsp;</div>
  
          <div class="user-view__form-container">
            <h2 class="heading-secondary ma-bt-md">Password change</h2>
            <form class="form form-user-settings">
              <div class="form__group">
                <label class="form__label" for="password-current"
                  >Current password</label
                >
                <input
                  id="password-current"
                  class="form__input"
                  type="password"
                  placeholder="••••••••"
                  required
                  minlength="8"
                />
              </div>
              <div class="form__group">
                <label class="form__label" for="password">New password</label>
                <input
                  id="password"
                  class="form__input"
                  type="password"
                  placeholder="••••••••"
                  required
                  minlength="8"
                />
              </div>
              <div class="form__group ma-bt-lg">
                <label class="form__label" for="password-confirm"
                  >Confirm password</label
                >
                <input
                  id="password-confirm"
                  class="form__input"
                  type="password"
                  placeholder="••••••••"
                  required
                  minlength="8"
                />
              </div>
              <div class="form__group right">
                <button class="btn btn--small btn--green" type="submit">
                  Save password
                </button>
              </div>
            </div>
            </form>
          </div>
      </div>
    </main>

    <%- include('footer') %>
  </body>

  <script src="/js/alerts.js"></script>
  <script src="js/login.js"></script>
</html>
